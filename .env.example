APP_NAME=HireSense AI
APP_VERSION=1.0.0
DEBUG=False
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/hiresense_db

POSTGRES_DB=hiresense_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/app/uploads
PARSER_DEFAULT_SECTION_GAP_LINES=3
MAX_RESUME_TEXT_CHARS=50000

MAILJET_API_KEY=
MAILJET_SECRET_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=HireSense AI
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=30
